          {
            "name": "Score in 10",
            "nameFA": "گلزنی در ۱۰ مسابقه",
            "description": "Score in 10 separate matches in Squad Battles on min. Semi-pro difficulty (or Rivals/Champions/Live Events/Rush) while using min. 3 players born on October 9, 2003 or after in your starting XI.",
            "descriptionFA": "در ۱۰ مسابقه جداگانه گل بزنید؛ حالت Squad Battles با سختی حداقل Semi-Pro یا Rivals / Champions / Live Events / Rush. حداقل ۳ بازیکن متولد ۹ اکتبر ۲۰۰۳ یا بعد از آن باید در ترکیب اصلی باشند.",
            "reward": "100 SP"
          },
          {
            "name": "Play 7",
            "nameFA": "انجام ۷ مسابقه",
            "description": "Play 7 matches in Squad Battles on min. Semi-Pro difficulty (or Rivals/Champions/Live Events/Rush) while using min. 3 players born on October 9, 2003 or after in your starting XI.",
            "descriptionFA": "۷ مسابقه در حالت‌های مجاز انجام دهید؛ در Squad Battles سختی حداقل Semi-Pro باشد و ۳ بازیکن متولد ۹ اکتبر ۲۰۰۳ یا بعد از آن در ترکیب اصلی داشته باشید.",
            "reward": "2,500 Coins"
          },
          {
            "name": "Assist 1",
            "nameFA": "ثبت یک پاس گل",
            "description": "Assist in 1 match in Squad Battles on min. Semi-Pro difficulty (or Rivals/Champions/Live Events/Rush) using a player born on October 9, 2003 or after.",
            "descriptionFA": "در یک مسابقه در حالت‌های مجاز، با بازیکن متولد ۹ اکتبر ۲۰۰۳ یا بعد از آن یک پاس گل بدهید؛ سختی Squad Battles حداقل Semi-Pro باشد.",
            "reward": "100 SP"
          }
